GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Default LLM Provider: gemini | groq | openai | mock
DEFAULT_LLM_PROVIDER=gemini

# Default Model
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_MODEL=gpt-4o-mini

# Default TTS Voice
# Indonesian: id-ID-GadisNeural, id-ID-ArdiNeural
# Japanese: ja-JP-NanamiNeural, ja-JP-KeitaNeural
# English: en-US-AnaNeural, en-US-JennyNeural
DEFAULT_TTS_VOICE=id-ID-GadisNeural
DEFAULT_TTS_RATE=+0%
DEFAULT_TTS_PITCH=+0Hz

# Server settings
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000
